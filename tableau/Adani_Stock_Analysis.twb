      <aliases enabled='yes' />
      <column caption='Annualized Volatility' datatype='real' default-format='p0.00%' name='[Calculation_1852729477324800]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='STDEV([daily_return])*SQRT(252)' />
      </column>
      <column caption='Positive Day %' datatype='real' default-format='p0.00%' name='[Calculation_1852729478029313]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;IF [daily_return] &gt; 0 THEN 1 ELSE 0 END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNT([daily_return])' />
      </column>
      <column caption='Adani Event Date' datatype='real' name='[Calculation_1852729524523012]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF[date] = DATE(&quot;2023-01-24&quot;) THEN [close] END' />
      </column>
